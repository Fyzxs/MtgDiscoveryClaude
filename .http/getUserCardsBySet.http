### Get User Cards By Set - Missing User ID (should fail)
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardsBySetNoUser($setArgs: UserCardsBySetInput!) {
  userCardsBySet(setArgs: $setArgs) {
    __typename
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "setArgs": {
    "setId": "452951cf-378b-4472-b7fe-572fe2af2ac0",
    "userId": ""
  }
}


### Get User Cards By Set - Missing Set ID (should fail)
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardsBySetNoSet($setArgs: UserCardsBySetInput!) {
  userCardsBySet(setArgs: $setArgs) {
    __typename
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "setArgs": {
    "setId": "",
    "userId": "6cd19505-4db6-5a83-94b5-8d58f7f8aa38"
  }
}


###
# Usage Notes:
# Returns all cards a user owns in a specific set
#
# Parameters:
# - userId: The unique identifier of the user
# - setId: The unique identifier of the set (GUID format)
#
# Response includes collectedList with finish/special/count for each card
