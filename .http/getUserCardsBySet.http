###
# Get User Cards By Set Query
# Frontend: client/src/graphql/queries/userCards.ts - GET_USER_CARDS_BY_SET
# Returns all cards owned by a user in a specific set
###
@baseUrl = https://localhost:65203
@gqlEndpoint = {{baseUrl}}/graphql


### Get User Cards By Set - Basic Query
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardsBySet($setArgs: UserCardsBySetInput!) {
  userCardsBySet(setArgs: $setArgs) {
    __typename
    ... on SuccessUserCardsCollectionResponse {
      data {
        userId
        cardId
        setId
        collectedList {
          finish
          special
          count
        }
      }
      status {
        message
        statusCode
      }
    }
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "setArgs": {
    "setId": "452951cf-378b-4472-b7fe-572fe2af2ac0",
    "userId": "6cd19505-4db6-5a83-94b5-8d58f7f8aa38"
  }
}


