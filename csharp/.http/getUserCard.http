### Get User Card - Missing User ID (should fail)
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardNoUser($cardArgs: UserCardInput!) {
  userCard(cardArgs: $cardArgs) {
    __typename
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "cardArgs": {
    "cardId": "02e8e540-8aa3-4e6a-9a11-c3949cab5f0f",
    "userId": ""
  }
}


### Get User Card - Missing Card ID (should fail)
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardNoCard($cardArgs: UserCardInput!) {
  userCard(cardArgs: $cardArgs) {
    __typename
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "cardArgs": {
    "cardId": "",
    "userId": "6cd19505-4db6-5a83-94b5-8d58f7f8aa38"
  }
}


###
# Usage Notes:
# Returns collection data for a single card owned by a user
#
# Parameters:
# - userId: The unique identifier of the user
# - cardId: The unique identifier of the card (GUID format)
#
# Response includes collectedList with finish/special/count
