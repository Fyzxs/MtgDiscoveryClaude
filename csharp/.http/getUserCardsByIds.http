###
# Get User Cards By IDs Query
# Frontend: client/src/graphql/queries/userCards.ts - GET_USER_CARDS_BATCH
# Returns collection data for multiple cards owned by a user
###
@baseUrl = https://localhost:65203
@gqlEndpoint = {{baseUrl}}/graphql


### Get User Cards By IDs - Basic Query
POST {{gqlEndpoint}}
Content-Type: application/json

query UserCardsByIds($cardsArgs: UserCardsByIdsInput!) {
  userCardsByIds(cardsArgs: $cardsArgs) {
    __typename
    ... on SuccessUserCardsCollectionResponse {
      data {
        userId
        cardId
        setId
        collectedList {
          finish
          special
          count
        }
      }
      status {
        message
        statusCode
      }
    }
    ... on FailureResponse {
      status {
        message
        statusCode
      }
    }
  }
}

{
  "cardsArgs": {
    "userId": "6cd19505-4db6-5a83-94b5-8d58f7f8aa38",
    "cardIds": [
      "02e8e540-8aa3-4e6a-9a11-c3949cab5f0f",
      "82ae4f7b-8122-4af6-8079-888eabf1a11e"
    ]
  }
}


