# HTTP Test Environment Variables - Example Template
# Copy this file to .env and update with your actual values

# GraphQL API Endpoint
BASE_URL=https://localhost:65203
GRAPHQL_ENDPOINT={{BASE_URL}}/graphql

# Authentication - Replace with your actual JWT token from Auth0
BEARER_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIs...

# User/Collection Identifiers - Replace with your actual IDs
COLLECTION_ID=auth0|1234567890abcdef

# Test Data - Replace with actual values from your database
TEST_PRODUCT_UUID=550c74d4-7bbb-4e31-95e8-3a50c39c2dcb
TEST_SET_ID=mkm
TEST_SET_CODE=mkm
